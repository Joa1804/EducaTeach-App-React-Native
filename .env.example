# Copie este arquivo para .env e preencha com os dados do app web no console do Firebase
# (Configurações do projeto > Seus apps). O .env NÃO deve ser commitado.
#
# Atenção: variáveis EXPO_PUBLIC_* são embutidas no bundle do app e ficam visíveis para
# qualquer pessoa. Use apenas a config pública do Firebase aqui, nunca segredos.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Opcional (só usado pelo Analytics na versão web)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Opcional, só em desenvolvimento: aponta Auth e Firestore para os emuladores locais
# (npm run emuladores). Deixe vazio para usar o projeto real.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
